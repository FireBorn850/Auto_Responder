#: .\reviews\templates\reviews\settings.html:851
msgid "AI Auto-Pilot &amp; Brand Voice"
msgstr "Pilote automatique IA et voix de marque"

msgid ""
"Configure how your AI assistant crafts automated replies to Google Business "
"Profile reviews."
msgstr ""
"Configurez la façon dont votre assistant IA rédige des réponses automatisées "
"aux avis de votre fiche Google Business Profile."

msgid "Engine Active"
msgstr "Moteur actif"

msgid ""
"Control when AI responses are published directly to Google versus saved as "
"drafts for review."
msgstr ""
"Contrôlez si les réponses de l'IA sont publiées directement sur Google ou "
"enregistrées comme brouillons pour validation."

msgid "Recommended"
msgstr "Recommandé"

msgid "Smart Guardrail"
msgstr "Garde-fou intelligent"

msgid "Auto-publish 4-5★ reviews"
msgstr "Publication automatique des avis 4-5★"

msgid "Positive reviews get replies instantly"
msgstr "Les avis positifs reçoivent une réponse instantanée"

msgid "1-3★ reviews routed to your inbox as drafts"
msgstr ""
"Les avis 1-3★ sont envoyés dans votre boîte de réception sous forme de "
"brouillons"

msgid "A human always reviews sensitive feedback"
msgstr "Un humain relit toujours les retours sensibles"

msgid "Hands-Free"
msgstr "Mains libres"

msgid "Auto-approve ALL ratings"
msgstr "Approbation automatique de TOUTES les notes"

msgid "Every reply is auto-approved instantly"
msgstr "Chaque réponse est approuvée automatiquement et instantanément"

msgid ""
"One-click copy to Google — direct auto-posting activates once Google's API "
"access is approved"
msgstr ""
"Copie en un clic vers Google — la publication automatique directe s'activera "
"une fois l'accès à l'API Google approuvé"

msgid "Zero manual approval needed"
msgstr "Aucune approbation manuelle nécessaire"

msgid ""
"We recommend reviewing your first 10 auto-posted replies before fully "
"trusting this mode."
msgstr ""
"Nous vous recommandons de vérifier vos 10 premières réponses publiées "
"automatiquement avant de faire entièrement confiance à ce mode."

msgid "Copilot Mode"
msgstr "Mode Copilote"

msgid "Manual approval required"
msgstr "Approbation manuelle requise"

msgid "AI drafts every response for you"
msgstr "L'IA rédige chaque réponse pour vous"

msgid "Nothing posts until you click Approve"
msgstr "Rien n'est publié tant que vous n'avez pas cliqué sur Approuver"

msgid "Full control over every reply"
msgstr "Contrôle total sur chaque réponse"

msgid "Brand Personality &amp; Voice"
msgstr "Personnalité et ton de la marque"

msgid "Select the overall style and language tone for public responses."
msgstr "Sélectionnez le style général et le ton des réponses publiques."

msgid "Warm &amp; Friendly"
msgstr "Chaleureux et amical"

msgid "Professional &amp; Formal"
msgstr "Professionnel et formel"

msgid "Casual &amp; Modern"
msgstr "Décontracté et moderne"

